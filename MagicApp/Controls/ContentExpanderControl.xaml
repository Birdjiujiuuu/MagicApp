<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MagicApp.Controls.ContentExpanderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MagicApp.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="current"
    HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent"/>

        <SolidColorBrush x:Key="ToggleButtonForeground"                    Color="{ThemeResource TextFillColorPrimary}"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver"         Color="{ThemeResource TextFillColorPrimary}"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundPressed"             Color="{ThemeResource TextFillColorPrimary}"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundDisabled"            Color="{ThemeResource TextFillColorPrimary}"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked"             Color="{ThemeResource TextFillColorPrimary}"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver"  Color="{ThemeResource TextFillColorPrimary}"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed"      Color="{ThemeResource TextFillColorPrimary}"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled"     Color="{ThemeResource TextFillColorPrimary}"/>

        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="{ThemeResource ControlFillColorDefault}"
            BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
            BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
            CornerRadius="5"
            HorizontalAlignment="Stretch">

        <Grid RowDefinitions="Auto,Auto">
            <Grid x:Name="HeaderArea"
                  Grid.Row="0"
                  PointerEntered="HeaderArea_PointerEntered"
                  PointerExited="HeaderArea_PointerExited">

                <!--  悬停高亮层  -->
                <Border x:Name="HoverOverlay"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="5,5,0,0"
                        Opacity="0"
                        IsHitTestVisible="False"/>

                <ToggleButton
                    x:Name="HeaderToggle"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsChecked="{x:Bind IsExpanded, Mode=TwoWay}">

                    <Grid Height="70" ColumnDefinitions="15,25,15,*,Auto,10,50">
                        <ContentPresenter Content="{x:Bind Icon, Mode=OneWay}"
                                          Grid.Column="1"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <Image Source="{Binding ElementName=current, Path=Image}" Width="20" Height="20" Grid.Column="1"/>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElementName=current, Path=Header}" Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock Text="{Binding ElementName=current, Path=Description}" FontSize="14" Foreground="Gray"/>
                        </StackPanel>

                        <ContentPresenter
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="{x:Bind SettingActionableElement, Mode=OneWay}"/>

                        <FontIcon Grid.Column="6"
                                  Glyph="&#xE70D;"
                                  FontSize="15"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform x:Name="ChevronRotation" Angle="0"/>
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Grid>
                </ToggleButton>
            </Grid>

            <!--  展开内容区  -->
            <Grid x:Name="ContentRoot"
                  Grid.Row="1"
                  Height="0"
                  Visibility="Collapsed"
                  VerticalAlignment="Top">

                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <muxc:ItemsRepeater
                        x:Name="ContentItemsRepeater"
                        Margin="0,4,0,12"
                        ItemsSource="{x:Bind Items, Mode=OneWay}"
                        ItemTemplate="{x:Bind ItemsTemplate, Mode=OneWay}"
                        HorizontalAlignment="Stretch">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:StackLayout Orientation="Vertical"/>
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>