<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MagicApp.Controls.ReleaseHistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootOverlay">
        <!-- 遮罩 -->
        <Rectangle x:Name="OverlayRect" Fill="#66000000"/>

        <!-- 卡片 -->
        <Grid x:Name="DraggableGroup"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 主卡片 -->
            <Border x:Name="Card"
                    Grid.Column="0"
                    Width="620" Height="620"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题区 -->
                    <Grid Grid.Row="0"
                          x:Name="TitleRegion"
                          Padding="28,22,28,12"
                          Background="Transparent">
                        <StackPanel>
                            <TextBlock x:Name="TitleText"
                                       Text="What's new"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 内容区 -->
                    <Grid Grid.Row="1">
                        <WebView2 x:Name="ContentWebView"
                                  DefaultBackgroundColor="Transparent"/>

                        <ProgressRing x:Name="LoadingRing"
                                      IsActive="True"
                                      Width="40" Height="40"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        <StackPanel x:Name="ErrorPanel"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    MaxWidth="380"
                                    Margin="24">
                            <FontIcon Glyph="&#xE783;" FontSize="24"/>
                            <TextBlock x:Name="ErrorText"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                            <Button x:Name="RetryButton"
                                    Content="Retry"
                                    HorizontalAlignment="Center"
                                    Click="RetryButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 关闭按钮 -->
            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    Width="40" Height="40"
                    Margin="10,0,0,0"
                    Padding="0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Click="CloseButton_Click">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>