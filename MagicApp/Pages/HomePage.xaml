<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MagicApp.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MagicApp.Pages"
    xmlns:controls="using:MagicApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer>
        <Grid Margin="0,30,0,0" RowDefinitions="Auto,*">
            <Border 
            Grid.Row="0"
            CornerRadius="8"
            MaxHeight="300"
            MaxWidth="600"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
                <FlipView>
                    <Image Source="https://birdjiujiuuu.github.io/magicapp/source/winui3/home/1.png" Stretch="Fill"/>
                    <Image Source="https://birdjiujiuuu.github.io/magicapp/source/winui3/home/2.png" Stretch="Fill"/>
                    <Image Source="https://birdjiujiuuu.github.io/magicapp/source/winui3/home/3.png" Stretch="Fill"/>
                </FlipView>
            </Border>

            <Border
            Grid.Row="1"
            Margin="30"
            Padding="10"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <TextBlock Name="NoticeTitle" HorizontalAlignment="Center" Style="{ThemeResource BaseTextBlockStyle}" FontSize="24"/>
                    <TextBlock Name="NoticeContent" TextWrapping="Wrap" FontSize="15"/>
                </StackPanel>
            </Border>
            <StackPanel
            Grid.Row="1"
            Margin="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
                <ProgressRing Name="NoticeProgressRing"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
