<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MagicApp.Pages.QRCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MagicApp.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MagicApp.Controls"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="20" ColumnDefinitions="*,*">
        <!-- 左侧输入区域 -->
        <Border Grid.Column="0"
                Margin="0,0,10,0"
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Spacing="15">
                <TextBlock x:Uid="Pages_QRCode_TitleGenerate" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBox x:Name="InputTextBox"
                         x:Uid="Pages_QRCode_InputTextBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="200"
                         VerticalAlignment="Stretch"
                         TextChanged="InputTextBox_TextChanged"/>

                <Grid ColumnDefinitions="*,*">
                    <controls:DataControl x:Name="TextLengthData"
                                    x:Uid="Pages_QRCode_TextLengthData"
                                    IconGlyph="&#xE8D2;"
                                    IconColor="#00A1D6"
                                    Margin="0,0,5,0"
                                    Grid.Column="0"/>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0" Orientation="Vertical">
                        <Button x:Name="ClearButton"
                                x:Uid="Pages_QRCode_ClearButton"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Stretch"
                                Click="ClearButton_Click"/>

                        <Button x:Name="GenerateButton"
                                x:Uid="Pages_QRCode_GenerateButton"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="GenerateButton_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 右侧预览区域 -->
        <Border Grid.Column="1"
                Margin="10,0,0,0"
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Spacing="15">
                <TextBlock x:Uid="Pages_QRCode_TitlePreview" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <!-- 二维码显示区域 -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="White"
                        CornerRadius="5"
                        Padding="5"
                        HorizontalAlignment="Center">
                    <Image x:Name="QRCodeImage"
                           Width="250"
                           Height="250"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <!-- 状态提示 -->
                <TextBlock x:Name="StatusTextBlock"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>