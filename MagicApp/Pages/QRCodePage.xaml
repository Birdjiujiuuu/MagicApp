<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MagicApp.Pages.QRCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MagicApp.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MagicApp.Controls"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- 顶部切换栏 -->
        <SelectorBar x:Name="ViewSelectorBar"
                     Grid.Row="0"
                     Margin="58,12,58,0"
                     SelectionChanged="ViewSelectorBar_SelectionChanged">
            <SelectorBarItem x:Name="GenerateTab" Text="生成" Icon="Edit"/>
            <SelectorBarItem x:Name="DecodeTab" Text="识别" Icon="Camera"/>
        </SelectorBar>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="58,12,58,20">

                <!-- ============ 生成区 ============ -->
                <Grid x:Name="GenerateView"
                      ColumnSpacing="20"
                      ColumnDefinitions="*,Auto">

                    <!-- 输入区 -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="15">
                            <TextBlock x:Uid="Pages_QRCode_TitleGenerate"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>

                            <TextBox x:Name="InputTextBox"
                                     x:Uid="Pages_QRCode_InputTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="180"
                                     MaxHeight="320"
                                     VerticalAlignment="Stretch"
                                     TextChanged="InputTextBox_TextChanged"/>
                            <controls:DataControl x:Name="TextLengthData"
                                                  x:Uid="Pages_QRCode_TextLengthData"
                                                  IconGlyph="&#xE8D2;"
                                                  IconColor="#00A1D6"/>
                            <Grid ColumnDefinitions="*,10,*">
                                <Button x:Name="ClearButton"
                                        x:Uid="Pages_QRCode_ClearButton"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Click="ClearButton_Click"/>
                                <Button x:Name="GenerateButton"
                                        x:Uid="Pages_QRCode_GenerateButton"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="GenerateButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 预览区 -->
                    <Border Grid.Column="1" Width="340" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="Pages_QRCode_TitlePreview"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>

                            <Border Background="White"
                                    CornerRadius="5"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    MinWidth="290"
                                    MinHeight="290">
                                <Image x:Name="QRCodeImage"
                                       Width="270"
                                       Height="270"
                                       Stretch="Uniform"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                <controls:ActionButton x:Name="CopyQRCodeButton" x:Uid="Pages_QRCode_CopyQRCodeButton" IconGlyph="&#xE8C8;" IsEnabled="False"/>
                                <controls:ActionButton x:Name="SaveQRCodeButton" x:Uid="Pages_QRCode_SaveQRCodeButton" IconGlyph="&#xE74E;" IsEnabled="False"/>
                            </StackPanel>

                            <TextBlock x:Name="StatusTextBlock"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ 识别区 ============ -->
                <Grid x:Name="DecodeView"
                      Visibility="Collapsed"
                      RowDefinitions="Auto,*"
                      RowSpacing="20">

                    <!-- 操作区 -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 拖拽/点击选图框 -->
                            <Button x:Name="DecodeDropButton"
                                    Grid.Column="0"
                                    Width="290"
                                    Height="290"
                                    Padding="0"
                                    Background="White"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    AllowDrop="True"
                                    DragOver="DecodePreview_DragOver"
                                    Drop="DecodePreview_Drop"
                                    Click="DecodeDropButton_Click">
                                <Grid>
                                    <TextBlock x:Name="DecodePlaceholderText"
                                               Text="点击选择图片，或拖拽到此处"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="20"/>
                                    <Image x:Name="DecodePreviewImage"
                                           Width="270"
                                           Height="270"
                                           Stretch="Uniform"/>
                                </Grid>
                            </Button>

                            <!-- 右侧操作按钮 -->
                            <StackPanel Grid.Column="1" 
                                        VerticalAlignment="Bottom" 
                                        Margin="12,0,0,0" 
                                        Spacing="6">
                                <!-- 粘贴 -->
                                <Button x:Name="PasteFromClipboardButton"
                                        Click="PasteFromClipboardButton_Click"
                                        ToolTipService.ToolTip="从剪贴板粘贴"
                                        Padding="10"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="4">
                                    <FontIcon Glyph="&#xE77F;" FontSize="16"/>
                                </Button>
                                <!-- 清空 -->
                                <Button x:Name="ClearDecodeButton"
                                        Click="ClearDecodeButton_Click"
                                        ToolTipService.ToolTip="清空"
                                        IsEnabled="False"
                                        Padding="10"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="4">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 状态提示 -->
                        <TextBlock x:Name="DecodeStatusTextBlock"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- 结果区 -->
                    <TextBox x:Name="DecodeResultTextBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalAlignment="Stretch"
                             PlaceholderText="识别结果会显示在这里"
                             MinHeight="160"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>