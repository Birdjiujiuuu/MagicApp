<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MagicApp.Pages.QRCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MagicApp.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MagicApp.Controls"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- 顶部切换栏 -->
        <SelectorBar x:Name="ViewSelectorBar"
                     Grid.Row="0"
                     Margin="58,12,58,0"
                     SelectionChanged="ViewSelectorBar_SelectionChanged">
            <SelectorBarItem x:Name="Tab_Generate" x:Uid="Pages_QRCode_Tab_Generate" Icon="Edit"/>
            <SelectorBarItem x:Name="Tab_Decode" x:Uid="Pages_QRCode_Tab_Decode" Icon="BrowsePhotos"/>
        </SelectorBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="58,12,58,20">

                <!-- ============ 生成区 ============ -->
                <Grid x:Name="GenerateView" ColumnSpacing="20" ColumnDefinitions="*,Auto">

                    <!-- 输入区 -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="15">
                            <TextBlock x:Uid="Pages_QRCode_Generate_Title"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>

                            <TextBox x:Name="Generate_InputTextBox"
                                     x:Uid="Pages_QRCode_Generate_InputTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="180"
                                     MaxHeight="320"
                                     VerticalAlignment="Stretch"
                                     TextChanged="Generate_InputTextBox_TextChanged"/>
                            <controls:DataControl x:Name="Generate_TextLengthData"
                                                  x:Uid="Pages_QRCode_Generate_TextLengthData"
                                                  IconGlyph="&#xE8D2;"
                                                  IconColor="#00A1D6"/>
                            <Grid ColumnDefinitions="*,10,*">
                                <Button x:Name="Generate_ClearButton"
                                        x:Uid="Pages_QRCode_Generate_ClearButton"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Click="Generate_ClearButton_Click"/>
                                <Button x:Name="Generate_GenerateButton"
                                        x:Uid="Pages_QRCode_Generate_GenerateButton"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="Generate_GenerateButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 预览区 -->
                    <Border Grid.Column="1" Width="340" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="Pages_QRCode_Generate_PreviewTitle"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>

                            <Border Background="White"
                                    CornerRadius="5"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    MinWidth="290"
                                    MinHeight="290">
                                <Image x:Name="Generate_QRCodeImage"
                                       Width="270"
                                       Height="270"
                                       Stretch="Uniform"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                <controls:ActionButton x:Name="Generate_CopyQRCodeButton" x:Uid="Pages_QRCode_Generate_CopyQRCodeButton" IconGlyph="&#xE8C8;" IsEnabled="False"/>
                                <controls:ActionButton x:Name="Generate_SaveQRCodeButton" x:Uid="Pages_QRCode_Generate_SaveQRCodeButton" IconGlyph="&#xE74E;" IsEnabled="False"/>
                            </StackPanel>

                            <TextBlock x:Name="Generate_StatusTextBlock"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ 识别区 ============ -->
                <Grid x:Name="DecodeView" Visibility="Collapsed" RowDefinitions="Auto,*" RowSpacing="10">

                    <!-- 操作区 -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8">
                        <Grid HorizontalAlignment="Center" ColumnDefinitions="Auto,Auto">
                            <!-- 拖拽/点击选图框 -->
                            <Button x:Name="Decode_DropButton"
                                    Grid.Column="0"
                                    Width="290"
                                    Height="290"
                                    Padding="0"
                                    Background="White"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    AllowDrop="True"
                                    DragOver="DecodePreview_DragOver"
                                    Drop="DecodePreview_Drop"
                                    Click="Decode_DropButton_Click">
                                <Grid>
                                    <TextBlock x:Name="Decode_PlaceholderText"
                                               x:Uid="Pages_QRCode_Decode_PlaceholderText"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="20"/>
                                    <Image x:Name="Decode_PreviewImage"
                                           Width="270"
                                           Height="270"
                                           Stretch="Uniform"/>
                                </Grid>
                            </Button>

                            <!-- 右侧操作按钮 -->
                            <StackPanel Grid.Column="1" 
                                        VerticalAlignment="Bottom" 
                                        Margin="12,0,0,0" 
                                        Spacing="6">
                                <!-- 粘贴 -->
                                <controls:ActionButton x:Name="Decode_PasteFromClipboardButton" x:Uid="Pages_QRCode_Decode_PasteFromClipboardButton" IconGlyph="&#xE77F;"/>
                                <!-- 清空 -->
                                <controls:ActionButton x:Name="Decode_ClearButton" x:Uid="Pages_QRCode_Decode_ClearButton" IconGlyph="&#xE74D;"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 结果区 -->
                    <TextBox x:Name="Decode_ResultTextBox"
                             x:Uid="Pages_QRCode_Decode_ResultTextBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalAlignment="Stretch"
                             IsHitTestVisible="False"
                             MinHeight="160"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>