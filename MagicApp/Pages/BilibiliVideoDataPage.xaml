<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MagicApp.Pages.BilibiliVideoDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MagicApp.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MagicApp.UI.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部搜索区域 -->
        <Grid Grid.Row="0" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="BvIdTextBox" 
                     Grid.Column="0"
                     PlaceholderText="请输入BV号 (例如：BV1xx411c7mD)"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     KeyDown="BvIdTextBox_KeyDown"/>
            <Button Grid.Column="1"
                    x:Name="SearchButton"
                    Content="查询视频"
                    Click="SearchButton_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <!-- 加载条区域 -->
        <ProgressBar x:Name="LoadingProgressBar" Grid.Row="1" Height="5" Margin="20,0,20,0" Visibility="Collapsed" IsIndeterminate="True"/>

        <!-- 主内容区域 -->
        <ScrollViewer Grid.Row="2" Margin="20,10,20,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20">

                <!-- 视频封面和基本信息 -->
                <Grid x:Name="VideoInfoContainer"
                      Visibility="Collapsed"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                      BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
                      CornerRadius="8"
                      Padding="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：封面 -->
                    <Border Grid.Column="0"
                            Width="300"
                            Height="180"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Image x:Name="CoverImage" Stretch="Fill"/>
                    </Border>

                    <!-- 右侧：基本信息 -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="12">
                        <!-- 视频标题 -->
                        <TextBlock x:Name="TitleTextBlock"
                                   TextWrapping="Wrap"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <!-- UP主信息 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PersonPicture x:Name="UpAvatar" Width="32" Height="32"/>
                            <TextBlock x:Name="UpNameTextBlock"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- 时长 -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <SymbolIcon Symbol="Clock"/>
                            <TextBlock x:Name="DurationTextBlock"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- 发布时间 -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <SymbolIcon Symbol="Calendar"/>
                            <TextBlock x:Name="PubDateTextBlock"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- 操作区 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">

                            <!-- 下载封面图片 -->
                            <Button x:Name="DownloadCoverButton"
                                    Click="DownloadCoverButton_Click"
                                    ToolTipService.ToolTip="下载封面">
                                <SymbolIcon Symbol="Save"/>
                            </Button>

                            <!-- 复制视频链接 -->
                            <Button x:Name="CopyLinkButton"
                                    Click="CopyLinkButton_Click"
                                    ToolTipService.ToolTip="复制链接">
                                <SymbolIcon Symbol="Link"/>
                            </Button>

                            <!-- 在浏览器打开视频 -->
                            <Button x:Name="OpenInBrowserButton"
                                    Click="OpenInBrowserButton_Click"
                                    ToolTipService.ToolTip="在浏览器打开">
                                <SymbolIcon Symbol="World"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 统计信息卡片 -->
                <Grid x:Name="StatsContainer" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <!-- 第一行 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 播放量 -->
                            <controls:DataControl x:Name="ViewDataControl"
                          Grid.Column="0"
                          Description="播放"
                          IconGlyph="&#xE768;"
                          IconColor="#00A1D6"
                          Margin="0,0,5,0"/>

                            <!-- 弹幕 -->
                            <controls:DataControl x:Name="DanmakuDataControl"
                          Grid.Column="1"
                          Description="弹幕"
                          IconGlyph="&#xE8BD;"
                          IconColor="#FB7299"
                          Margin="5,0,5,0"/>

                            <!-- 评论 -->
                            <controls:DataControl x:Name="ReplyDataControl"
                          Grid.Column="2"
                          Description="评论"
                          IconGlyph="&#xE8F2;"
                          IconColor="#007AFF"
                          Margin="5,0,0,0"/>
                        </Grid>

                        <!-- 第二行 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 点赞 -->
                            <controls:DataControl x:Name="LikeDataControl"
                          Grid.Column="0"
                          Description="点赞"
                          IconGlyph="&#xE8E1;"
                          IconColor="#FF9500"
                          Margin="0,0,5,0"/>

                            <!-- 投币 -->
                            <controls:DataControl x:Name="CoinDataControl"
                          Grid.Column="1"
                          Description="投币"
                          IconGlyph="&#xE719;"
                          IconColor="#FFCC00"
                          Margin="5,0,5,0"/>

                            <!-- 收藏 -->
                            <controls:DataControl x:Name="FavoriteDataControl"
                          Grid.Column="2"
                          Description="收藏"
                          IconGlyph="&#xE734;"
                          IconColor="#34C759"
                          Margin="5,0,5,0"/>

                            <!-- 分享 -->
                            <controls:DataControl x:Name="ShareDataControl"
                          Grid.Column="3"
                          Description="分享"
                          IconGlyph="&#xE72D;"
                          IconColor="#5856D6"
                          Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 其他信息 -->
                <Grid x:Name="OtherInfoContainer"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 视频简介 -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                            BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="视频简介"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <ScrollViewer MaxHeight="150"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="DescriptionTextBlock"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </ScrollViewer>
                            <Button x:Name="CopyDescriptionButton"
                                    Click="CopyDescriptionButton_Click"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0"
                                    ToolTipService.ToolTip="复制链接">
                                <SymbolIcon Symbol="Copy"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 其他信息 -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                            BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="其他信息"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="视频ID："
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,8,4"/>
                                <TextBlock x:Name="BvidTextBlock"
                                           Grid.Row="0" Grid.Column="1"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="AV号："
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,8,4"/>
                                <TextBlock x:Name="AidTextBlock"
                                           Grid.Row="1" Grid.Column="1"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="视频类型："
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,8,4"/>
                                <TextBlock x:Name="CopyrightTextBlock"
                                           Grid.Row="2" Grid.Column="1"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="视频状态："
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,8,4"/>
                                <TextBlock x:Name="VideoStateTextBlock"
                                           Grid.Row="3" Grid.Column="1"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="抓取时间："
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="FetchTimeTextBlock"
                                           Grid.Row="4" Grid.Column="1"
                                           FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 错误提示 -->
                <Grid x:Name="ErrorGrid"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <SymbolIcon Symbol="Cancel"
                                    Width="48"
                                    Height="48"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock x:Name="ErrorMessageTextBlock"
                                   Text="查询失败，请检查BV号是否正确"
                                   FontSize="16"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>