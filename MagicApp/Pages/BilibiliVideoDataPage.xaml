<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MagicApp.Pages.BilibiliVideoDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MagicApp.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部搜索区域 -->
        <Grid Grid.Row="0" 
              Padding="20" 
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 搜索框 -->
            <TextBox x:Name="BvIdTextBox" 
                     Grid.Column="0"
                     PlaceholderText="请输入BV号 (例如：BV1xx411c7mD)"
                     FontSize="14"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"/>

            <!-- 搜索按钮 -->
            <Button Grid.Column="1"
                    x:Name="SearchButton"
                    Content="查询视频"
                    Click="SearchButton_Click"
                    FontSize="14"
                    Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <!-- 主内容区域 -->
        <ScrollViewer Grid.Row="1" 
                      Padding="20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20">

                <!-- 视频封面和基本信息 -->
                <Grid x:Name="VideoInfoContainer"
                      Visibility="Collapsed"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8"
                      Padding="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：封面 -->
                    <Border Grid.Column="0"
                            Width="300"
                            Height="180"
                            CornerRadius="4"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Image x:Name="CoverImage"
                               Stretch="UniformToFill"/>
                    </Border>

                    <!-- 右侧：基本信息 -->
                    <StackPanel Grid.Column="1" 
                                Margin="20,0,0,0"
                                Spacing="12">
                        <!-- 视频标题 -->
                        <TextBlock x:Name="TitleTextBlock"
                                   TextWrapping="Wrap"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <!-- UP主信息 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PersonPicture x:Name="UpAvatar"
                                           Width="32"
                                           Height="32"/>
                            <TextBlock x:Name="UpNameTextBlock"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- 分区信息 -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <SymbolIcon Symbol="World"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TypeNameTextBlock"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <SymbolIcon Symbol="Calendar"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="PubDateTextBlock"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 统计信息卡片 -->
                <Grid x:Name="StatsContainer"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 主要统计数据 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 播放量 -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,5,0">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <SymbolIcon Symbol="Play"
                                            Width="24"
                                            Height="24"
                                            Foreground="#00A1D6"/>
                                <TextBlock x:Name="ViewTextBlock"
                                           Text="--"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="播放"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 弹幕 -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="5,0,5,0">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <SymbolIcon Symbol="Message"
                                            Width="24"
                                            Height="24"
                                            Foreground="#FB7299"/>
                                <TextBlock x:Name="DanmakuTextBlock"
                                           Text="--"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="弹幕"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 点赞 -->
                        <Border Grid.Column="2"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="5,0,5,0">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <SymbolIcon Symbol="Like"
                                            Width="24"
                                            Height="24"
                                            Foreground="#FF9500"/>
                                <TextBlock x:Name="LikeTextBlock"
                                           Text="--"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="点赞"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 投币 -->
                        <Border Grid.Column="3"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="5,0,5,0">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <SymbolIcon Symbol="Send"
                                            Width="24"
                                            Height="24"
                                            Foreground="#FFCC00"/>
                                <TextBlock x:Name="CoinTextBlock"
                                           Text="--"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="投币"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 收藏 -->
                        <Border Grid.Column="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="5,0,5,0">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <SymbolIcon Symbol="Favorite"
                                            Width="24"
                                            Height="24"
                                            Foreground="#34C759"/>
                                <TextBlock x:Name="FavoriteTextBlock"
                                           Text="--"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="收藏"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 分享 -->
                        <Border Grid.Column="5"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="5,0,0,0">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <SymbolIcon Symbol="Share"
                                            Width="24"
                                            Height="24"
                                            Foreground="#5856D6"/>
                                <TextBlock x:Name="ShareTextBlock"
                                           Text="--"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="分享"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 其他信息 -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 视频简介 -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="视频简介"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <ScrollViewer MaxHeight="150"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="DescriptionTextBlock"
                                               Text="暂无简介"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- 其他信息 -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="其他信息"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="视频ID："
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,8,4"/>
                                    <TextBlock x:Name="BvidTextBlock"
                                               Grid.Row="0" Grid.Column="1"
                                               FontSize="12"
                                               Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="AV号："
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,8,4"/>
                                    <TextBlock x:Name="AidTextBlock"
                                               Grid.Row="1" Grid.Column="1"
                                               FontSize="12"
                                               Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="发布时间："
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,8,4"/>
                                    <TextBlock x:Name="PubTimeTextBlock"
                                               Grid.Row="2" Grid.Column="1"
                                               FontSize="12"
                                               Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="评论数："
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ReplyTextBlock"
                                               Grid.Row="3" Grid.Column="1"
                                               FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 加载状态 -->
                <Grid x:Name="LoadingGrid"
                      Visibility="Collapsed"
                      Height="100"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ProgressRing IsActive="True"
                                      Width="40"
                                      Height="40"/>
                        <TextBlock Text="正在查询视频数据..."
                                   Margin="0,12,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- 错误提示 -->
                <Grid x:Name="ErrorGrid"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <SymbolIcon Symbol="Cancel"
                                    Width="48"
                                    Height="48"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock x:Name="ErrorMessageTextBlock"
                                   Text="查询失败，请检查BV号是否正确"
                                   FontSize="16"/>
                        <Button Content="重试"
                                HorizontalAlignment="Center"
                                Click="SearchButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 空状态 -->
                <Grid x:Name="EmptyGrid"
                      Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <SymbolIcon Symbol="Video"
                                    Width="64"
                                    Height="64"
                                    Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                        <TextBlock Text="输入BV号查询视频数据"
                                   FontSize="16"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>