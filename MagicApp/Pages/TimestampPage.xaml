<Page x:Class="MagicApp.Pages.TimestampPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MagicApp.Pages"
      xmlns:controls="using:MagicApp.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- 卡片样式 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefault}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </Page.Resources>
    
    <ScrollViewer>
        <StackPanel Margin="10,20" Spacing="10">
            <!-- 实时显示 -->
            <Grid ColumnDefinitions="*,*,*">
                <controls:DataControl x:Name="CurrentTimeData"
                                      x:Uid="Pages_Timestamp_CurrentTimeData"
                                      IconGlyph="&#xE823;"
                                      IconColor="#00A1D6"
                                      Margin="0,0,5,0"
                                      Grid.Column="0"/>
                <controls:DataControl x:Name="CurrentTimestampData"
                                      x:Uid="Pages_Timestamp_CurrentTimestampData"
                                      IconGlyph="&#xE823;"
                                      IconColor="#00A1D6"
                                      Margin="5,0,5,0"
                                      Grid.Column="1"/>
                <controls:DataControl x:Name="CurrentMillisecondsData"
                                      x:Uid="Pages_Timestamp_CurrentMillisecondsData"
                                      IconGlyph="&#xE823;"
                                      IconColor="#00A1D6"
                                      Margin="5,0,0,0"
                                      Grid.Column="2"/>
            </Grid>

            <!-- 日期时间转时间戳卡片 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="Pages_Timestamp_DateTimeToTimestampCardTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <DatePicker x:Name="DatePickerInput"/>
                        <TimePicker x:Name="TimePickerInput" ClockIdentifier="24HourClock"/>
                        <ComboBox x:Name="SecondsComboBox" Width="70"/>
                        <Button x:Uid="Pages_Timestamp_ConvertButton" Style="{StaticResource AccentButtonStyle}" Click="OnConvertDateTimeToTimestamp"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Uid="Pages_Timestamp_ConvertedResult" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ConvertedTimestampResult" VerticalAlignment="Center" Width="150" TextWrapping="Wrap"/>
                        <controls:ActionButton x:Name="CopyTimestampResultButton" x:Uid="Pages_Timestamp_CopyTimestampResultButton" IconGlyph="&#xE8C8;"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 时间戳转日期时间卡片 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="Pages_Timestamp_TimestampToDateTimeCardTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnDefinitions="*,10,Auto">
                        <AutoSuggestBox x:Name="TimestampInput" x:Uid="Pages_Timestamp_TimestampInput" Grid.Column="0" TextChanged="TimestampInput_TextChanged"/>
                        <ComboBox x:Name="TimestampUnitComboBox" Grid.Column="2" Width="150" SelectedIndex="0" SelectionChanged="TimestampUnitComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="SecondsComboBoxItem" x:Uid="Pages_Timestamp_SecondsComboBoxItem"/>
                            <ComboBoxItem x:Name="MillisecondsComboBoxItem" x:Uid="Pages_Timestamp_MillisecondsComboBoxItem"/>
                        </ComboBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Uid="Pages_Timestamp_ConvertedResult" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ConvertedDateTimeResult" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>